{
  "openapi": "3.0.1",
  "info": {
    "title": "ballware Ml user API",
    "version": "v1"
  },
  "paths": {
    "/ml/mlmodel/selectlist": {
      "get": {
        "tags": [
          "MlModel"
        ],
        "summary": "Query list of all documents",
        "operationId": "MlModelSelectList",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MlModelSelectListEntry"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/ml/mlmodel/selectbyid/{id}": {
      "get": {
        "tags": [
          "MlModel"
        ],
        "summary": "Query select item by id",
        "operationId": "MlModelSelectById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MlModelSelectListEntry"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/ml/mlmodel/consumebyid/{modelId}": {
      "get": {
        "tags": [
          "MlModel"
        ],
        "summary": "Consume model by id",
        "operationId": "MlModelConsumeById",
        "parameters": [
          {
            "name": "modelId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/ml/mlmodel/train": {
      "post": {
        "tags": [
          "MlModel"
        ],
        "summary": "Train models",
        "operationId": "MlModelTrain",
        "responses": {
          "201": {
            "description": "Created"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MlModelSelectListEntry": {
        "required": [
          "Identifier"
        ],
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "format": "uuid"
          },
          "Identifier": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "oidc": {
        "type": "openIdConnect",
        "openIdConnectUrl": "https://identity.ballware.de/realms/ballware/.well-known/openid-configuration"
      }
    }
  },
  "security": [
    {
      "oidc": [
        "openid",
        "mlApi"
      ]
    }
  ]
}
